DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Supabase Storage for lesson media uploads.
# The bucket should be public for persistent lesson media URLs in MVP.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_STORAGE_BUCKET=your-storage-bucket
# Optional custom/CDN public base, for example:
# SUPABASE_STORAGE_PUBLIC_URL=https://cdn.example.com/lesson-media
